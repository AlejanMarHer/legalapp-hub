generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Caso {
  id                  String   @id @default(uuid())
  userId              String   // ID de Clerk del abogado
  
  // 1. Identificación del Proceso
  radicado            String?
  juzgado             String?
  ciudad              String?  @default("Bogotá D.C.")
  areaDerecho         String?  @default("Civil") // Civil, Laboral, Familia, etc.
  claseProceso        String?  // Ejecutivo Singular, Ordinario, etc.
  estadoInterno       String?  @default("Activo") // Activo, Archivado, Terminado
  
  // 2. Partes Procesales
  demandante          String
  idDemandante        String?  // C.C. o NIT
  demandado           String
  idDemandado         String?  // C.C. o NIT
  calidadProcesal     String?  @default("Apoderado Demandante") // A quién representamos
  
  // 3. Datos Financieros
  cuantia             Float?   @default(0)
  capitalBase         Float?   @default(0)
  honorariosPactados  String?  // Texto libre: "20% Cuota Litis", "$5.000.000 fijos"
  saldoHonorarios     Float?   @default(0)
  
  // 4. Contacto del Cliente
  telCliente          String?
  emailCliente        String?
  dirCliente          String?
  notasContacto       String?  // "Solo llamar en las tardes"
  
  // 5. Contraparte
  abogadoContraparte  String?
  emailContraparte    String?
  telContraparte      String?
  
  // 6. Hitos y Plazos
  fechaPresentacion   DateTime?
  fechaAdmision       DateTime?
  fechaVencimiento    DateTime? // Próximo término a vencer
  descVencimiento     String?   // "Contestar excepciones"
  
  // 7. Observaciones
  resumenHechos       String?   @db.Text
  apuntesPrivados     String?   @db.Text

  // Relación con el Cliente
  clienteId           String?
  cliente             Cliente?  @relation(fields: [clienteId], references: [id])
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relaciones secundarias
  liquidaciones       Liquidacion[]
  abonos              Abono[]
  documentos          Documento[] // NUEVO: Para enlazar los PDFs de Vercel Blob al caso

  // Campos del Radar Judicial
  radarUltimaConsulta  DateTime?
  radarUltimaActuacion String?
  radarFechaActuacion  DateTime?
  radarAlerta          Boolean   @default(false)
}

model Liquidacion {
  id        String   @id @default(cuid())
  tipo      String   // Ej. "Intereses", "Indexación", "Laboral"
  datos     Json     // Aquí guardaremos todos los números y resultados
  
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Abono {
  id        String   @id @default(cuid())
  monto     Float
  concepto  String?
  fecha     DateTime @default(now())
  
  casoId    String
  caso      Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
}

model Argumento {
  id            String   @id @default(cuid())
  titulo        String   
  contenido     String   @db.Text 
  ramaDerecho   String   
  palabrasClave String?  
  
  userId        String   
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Configuracion {
  id             String   @id @default(cuid())
  userId         String   @unique
  
  nombreDespacho String?  
  logoBase64     String?  @db.Text 
  firmaBase64    String?  @db.Text 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Tarea {
  id               String    @id @default(cuid())
  titulo           String    
  descripcion      String?   @db.Text
  estado           String    @default("POR HACER") 
  prioridad        String    @default("Media") 
  fechaVencimiento DateTime? 
  
  userId           String    
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Cliente {
  id             String   @id @default(cuid())
  nombre         String
  identificacion String?  
  email          String?
  telefono       String?
  direccion      String?
  notas          String?  @db.Text
  
  userId         String   
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  casos          Caso[]   
}

// ==========================================
// NUEVOS MODELOS: PAGOS, SUSCRIPCIONES Y ARCHIVOS
// ==========================================

model Suscripcion {
  id                    String    @id @default(cuid())
  userId                String    @unique // ID de Clerk del abogado
  plan                  String    @default("GRATIS") // GRATIS o PRO
  
  // Conexión con Mercado Pago
  mpPreapprovalId       String?   @unique // ID de la suscripción mensual en MP
  mpPayerId             String?   // ID del cliente en MP
  estadoPago            String?   // "authorized", "paused", "cancelled"
  fechaVencimiento      DateTime? 
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Documento {
  id          String   @id @default(cuid())
  nombre      String   // Ej: "Demanda_CGP.pdf"
  urlArchivo  String   // Enlace directo de Vercel Blob
  tamanoBytes Int?
  
  casoId      String
  caso        Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}