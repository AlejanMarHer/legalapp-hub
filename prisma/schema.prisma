generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Caso {
  id            String         @id @default(cuid())
  userId        String         // ID del abogado (Clerk)
  radicado      String?
  demandante    String
  demandado     String
  juzgado       String?
  estado        String         @default("Activo")
  
  // Esta línea crea la conexión: Un caso tiene muchas liquidaciones
  liquidaciones Liquidacion[]  
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Liquidacion {
  id          String   @id @default(cuid())
  tipo        String   // Ej. "Intereses", "Indexación", "Laboral"
  datos       Json     // Aquí guardaremos todos los números y resultados
  
  // Conexión obligatoria con el Expediente
  casoId      String
  caso        Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}