generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Caso {
  id                  String   @id @default(uuid())
  userId              String   // ID de Clerk del abogado
  
  // 1. Identificación del Proceso
  radicado            String?
  juzgado             String?
  ciudad              String?  @default("Bogotá D.C.")
  areaDerecho         String?  @default("Civil") // Civil, Laboral, Familia, etc.
  claseProceso        String?  // Ejecutivo Singular, Ordinario, etc.
  estadoInterno       String?  @default("Activo") // Activo, Archivado, Terminado
  
  // 2. Partes Procesales
  demandante          String
  idDemandante        String?  // C.C. o NIT
  demandado           String
  idDemandado         String?  // C.C. o NIT
  calidadProcesal     String?  @default("Apoderado Demandante") // A quién representamos
  
  // 3. Datos Financieros
  cuantia             Float?   @default(0)
  capitalBase         Float?   @default(0)
  honorariosPactados  String?  // Texto libre: "20% Cuota Litis", "$5.000.000 fijos"
  saldoHonorarios     Float?   @default(0)
  
  // 4. Contacto del Cliente
  telCliente          String?
  emailCliente        String?
  dirCliente          String?
  notasContacto       String?  // "Solo llamar en las tardes"
  
  // 5. Contraparte
  abogadoContraparte  String?
  emailContraparte    String?
  telContraparte      String?
  
  // 6. Hitos y Plazos
  fechaPresentacion   DateTime?
  fechaAdmision       DateTime?
  fechaVencimiento    DateTime? // Próximo término a vencer
  descVencimiento     String?   // "Contestar excepciones"
  
  // 7. Observaciones
  resumenHechos       String?   @db.Text
  apuntesPrivados     String?   @db.Text
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relación con el historial de cálculos
  liquidaciones       Liquidacion[]

  abonos        Abono[]
}

model Liquidacion {
  id          String   @id @default(cuid())
  tipo        String   // Ej. "Intereses", "Indexación", "Laboral"
  datos       Json     // Aquí guardaremos todos los números y resultados
  
  // Conexión obligatoria con el Expediente
  casoId      String
  caso        Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Abono {
  id          String   @id @default(cuid())
  monto       Float
  concepto    String?
  fecha       DateTime @default(now())
  
  casoId      String
  caso        Caso     @relation(fields: [casoId], references: [id], onDelete: Cascade)
}

model Argumento {
  id            String   @id @default(cuid())
  titulo        String   // Ej: "Falta de Legitimación en la Causa por Pasiva"
  contenido     String   @db.Text // @db.Text permite guardar textos muy largos
  ramaDerecho   String   // Ej: "Civil", "Laboral", "Constitucional"
  palabrasClave String?  // Ej: "excepciones, demanda, cobro"
  
  userId        String   // Para que tus argumentos sean privados y solo tuyos
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Configuracion {
  id             String   @id @default(cuid())
  userId         String   @unique
  
  nombreDespacho String?  // Ej: "Martínez & Asociados" o "Alejandro Martinez Abogados"
  logoBase64     String?  @db.Text // Aquí guardaremos tu Logo convertido en código
  firmaBase64    String?  @db.Text // Aquí guardaremos tu firma con fondo transparente
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}